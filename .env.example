# Copy to ".env" and fill in from your Appwrite project.

# Appwrite Cloud: https://cloud.appwrite.io/v1   (self-hosted: https://<your-host>/v1)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# Project Settings -> Project ID
VITE_APPWRITE_PROJECT_ID=your-project-id
# Database id to create/use (any slug; must match what the setup script makes)
VITE_APPWRITE_DB_ID=splitit

# Server API key, used ONLY by `npm run setup` to create the database/collections.
# Create under Overview -> API keys with scopes: databases.*, collections.*, attributes.*, indexes.*
# This is secret — it stays in .env (gitignored) and is never shipped to the browser.
APPWRITE_API_KEY=your-server-api-key
