# Copy to .env and fill in. Get these from the Appwrite console.
# The three VITE_ vars are also what you set in Vercel (Project → Settings → Environment Variables).

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DB_ID=splitit

# Only needed locally for `npm run setup` / `npm run deploy:fn`. NOT needed by Vercel. Never commit the real key.
APPWRITE_API_KEY=your_api_key

# Push notifications (npm run deploy:fn notify-expense). Generate with: npx web-push generate-vapid-keys
# The public key is safe in the app; the private key must stay here and in the Appwrite function only.
VITE_VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key

# Gmail sender for reminder emails (npm run add:gmail). App Password from myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_letter_app_password
